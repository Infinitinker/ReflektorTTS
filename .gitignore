# Python: the virtual environment, bytecode and package metadata
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Build output: the release and end-to-end builds, and the native builds (native/build, native/build64)
build/
build64/
dist/

# Caches of the checks, and test coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors and their personal settings
.vscode/
.idea/
.vs/
CMakeUserPresets.json

# Claude Code's personal files; the rest of .claude/ is shared
.claude/settings.local.json
.claude/launch.json

# Logs
*.log

# Never committed: secrets, and crash dumps, which can hold an app's memory
.env
*.dmp
