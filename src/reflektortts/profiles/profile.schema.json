{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReflektorTTS profile",
  "description": "Describes one app: how to recognize it, where to read its text and how to process it.",
  "type": "object",
  "required": [
    "version",
    "app",
    "match"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Profile format version.",
      "const": 1
    },
    "app": {
      "type": "object",
      "required": [
        "title",
        "year"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "The app's title, as shown to users.",
          "type": "string",
          "minLength": 1
        },
        "year": {
          "description": "Year of the original release.",
          "type": "integer",
          "minimum": 1970,
          "maximum": 2100
        }
      }
    },
    "match": {
      "description": "How to recognize the running program.",
      "type": "object",
      "required": [
        "executables"
      ],
      "additionalProperties": false,
      "properties": {
        "executables": {
          "description": "The program's executables; one program can ship several.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "The file name, without folders, e.g. \"gta2.exe\".",
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\\\/]+$"
              },
              "sha256": {
                "description": "SHA-256 of each supported build of the file, in lowercase hex. Without it, any build with this name matches.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "overlay": {
      "description": "Whether the overlay is loaded into the app. Default: false. Needs the executables' sha256, so the overlay only goes into builds it was tested with.",
      "type": "boolean"
    },
    "sources": {
      "description": "Where to read the app's text. Each source's other fields are defined by its plugin's own schema.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "name"
        ],
        "properties": {
          "type": {
            "description": "Source plugin, e.g. \"memory\".",
            "type": "string",
            "minLength": 1
          },
          "name": {
            "description": "Name of this source within the profile, shown in messages.",
            "type": "string",
            "minLength": 1
          },
          "poll_interval_ms": {
            "description": "Milliseconds between reads. Default: 250.",
            "type": "integer",
            "minimum": 10,
            "maximum": 60000
          },
          "stages": {
            "description": "Processing applied in order to this source's text. Each stage's other fields are defined by its plugin's own schema.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "description": "Stage plugin, e.g. \"tracker\".",
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "description": "Whether the stage starts on for the text shown (subtitles). Default: true.",
                  "type": "boolean"
                },
                "speech": {
                  "description": "Whether the stage starts on for what is spoken. Default: true.",
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
