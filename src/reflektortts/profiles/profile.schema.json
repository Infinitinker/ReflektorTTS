{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReflektorTTS game profile",
  "description": "Describes one game: how to recognize it and, later, where to read its text.",
  "type": "object",
  "required": ["version", "game", "match"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Profile format version.",
      "const": 2
    },
    "game": {
      "type": "object",
      "required": ["title", "year"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "The game's title, as shown to users.",
          "type": "string",
          "minLength": 1
        },
        "year": {
          "description": "Year of the original release.",
          "type": "integer",
          "minimum": 1970,
          "maximum": 2100
        }
      }
    },
    "match": {
      "description": "How to recognize the running game.",
      "type": "object",
      "required": ["process"],
      "additionalProperties": false,
      "properties": {
        "process": {
          "description": "Executable names of the game, without folders, e.g. \"gta2.exe\".",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\/]+$"
          }
        }
      }
    },
    "sources": {
      "description": "Where to read the game's text. Each source's other fields are defined by its plugin's own schema.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": {
            "description": "Source plugin, e.g. \"memory\".",
            "type": "string",
            "minLength": 1
          },
          "name": {
            "description": "Name of this source within the profile, shown in messages.",
            "type": "string",
            "minLength": 1
          },
          "poll_interval_ms": {
            "description": "Milliseconds between reads. Default: 250.",
            "type": "integer",
            "minimum": 10,
            "maximum": 60000
          },
          "stages": {
            "description": "Processing applied in order to this source's text. Each stage's other fields are defined by its plugin's own schema.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "description": "Stage plugin, e.g. \"tracker\".",
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
