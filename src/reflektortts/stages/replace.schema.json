{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Replace stage settings",
  "description": "Text replacements, applied in order.",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["find", "replace"],
            "additionalProperties": false,
            "properties": {
              "find": { "description": "Text to look for, matched literally.", "type": "string", "minLength": 1 },
              "replace": { "description": "Text to put in its place; empty to remove it.", "type": "string" }
            }
          },
          {
            "type": "object",
            "required": ["pattern", "replace"],
            "additionalProperties": false,
            "properties": {
              "pattern": {
                "description": "Regular expression to look for (Python syntax), e.g. \"#([^#]*)#\".",
                "type": "string",
                "minLength": 1,
                "format": "regex"
              },
              "replace": {
                "description": "Replacement; \\1, \\2... insert the pattern’s groups, e.g. \"\\1\".",
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
